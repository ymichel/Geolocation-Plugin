{
    "name": "ymichel/geolocation",
    "type": "wordpress-plugin",
    "description": "Displays post geotag information on an embedded map",
    "homepage": "https://github.com/ymichel/Geolocation-Plugin/",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Yann Michel",
            "email": "yann@michelpunkt.de"
        }
    ],
    "scripts": {
        "lint": "phpcs --standard=WordPress --extensions=php \"--ignore=vendor,tests,node_modules,*/\\.[a-z]*/*\" .",
        "fix": "phpcbf --standard=WordPress --extensions=php \"--ignore=vendor,tests,node_modules,*/\\.[a-z]*/*\" .",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "phpunit"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.0",
        "phpstan/phpstan": "^2.3",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": false
        }
    }
}
